pragma solidity ^0.8.0;

contract CommunityFunding {
    struct FundingProject {
        address payable projectOwner;
        uint256 fundingTarget;
        uint256 endTime;
        uint256 totalCollected;
        bool isFundsClaimed;
        mapping(address => uint256) backerContributions;
    }

    uint256 public projectCount;
    mapping(uint256 => FundingProject) public projects;

    event ProjectStarted(uint256 projectId, address owner, uint256 target, uint256 endTime);
    event BackerAdded(uint256 projectId, address backer, uint256 amount);
    event FundsClaimed(uint256 projectId, uint256 amount);
    event RefundProcessed(uint256 projectId, address backer, uint256 amount);

    modifier onlyOwner(uint256 _projectId) {
        require(msg.sender == projects[_projectId].projectOwner, "Only the project owner can perform this action");
        _;
    }

    modifier isActive(uint256 _projectId) {
        require(block.timestamp < projects[_projectId].endTime, "Project funding period has ended");
        _;
    }

    modifier isEnded(uint256 _projectId) {
        require(block.timestamp >= projects[_projectId].endTime, "Project funding period is still active");
        _;
    }

    function launchProject(uint256 _target, uint256 _durationDays) external {
        require(_target > 0, "Funding target must be greater than zero");
        require(_durationDays > 0, "Duration must be greater than zero");

        uint256 endTime = block.timestamp + (_durationDays * 1 days);

        FundingProject storage newProject = projects[projectCount];
        newProject.projectOwner = payable(msg.sender);
        newProject.fundingTarget = _target;
        newProject.endTime = endTime;

        emit ProjectStarted(projectCount, msg.sender, _target, endTime);
        projectCount++;
    }

    function supportProject(uint256 _projectId) external payable isActive(_projectId) {
        FundingProject storage project = projects[_projectId];
        require(msg.value > 0, "Support amount must be greater than zero");

        project.totalCollected += msg.value;
        project.backerContributions[msg.sender] += msg.value;

        emit BackerAdded(_projectId, msg.sender, msg.value);
    }

    function claimProjectFunds(uint256 _projectId) external onlyOwner(_projectId) isEnded(_projectId) {
        FundingProject storage project = projects[_projectId];
        require(project.totalCollected >= project.fundingTarget, "Project did not reach its funding target");
        require(!project.isFundsClaimed, "Funds have already been claimed");

        project.isFundsClaimed = true;
        uint256 amount = project.totalCollected;

        project.projectOwner.transfer(amount);

        emit FundsClaimed(_projectId, amount);
    }

    function requestRefund(uint256 _projectId) external isEnded(_projectId) {
        FundingProject storage project = projects[_projectId];
        require(project.totalCollected < project.fundingTarget, "Project reached its funding target");

        uint256 contribution = project.backerContributions[msg.sender];
        require(contribution > 0, "No contributions found for sender");

        project.backerContributions[msg.sender] = 0;
        payable(msg.sender).transfer(contribution);

        emit RefundProcessed(_projectId, msg.sender, contribution);
    }

    function fetchProjectDetails(uint256 _projectId) external view returns (
        address owner,
        uint256 target,
        uint256 endTime,
        uint256 collected,
        bool claimed
    ) {
        FundingProject storage project = projects[_projectId];
        return (
            project.projectOwner,
            project.fundingTarget,
            project.endTime,
            project.totalCollected,
            project.isFundsClaimed
        );
    }
}
